{
  "appId": "com.overdesk.fxcalendar",
  "productName": "Overdesk FX Calendar",
  "directories": {
    "output": "dist-electron"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Bl3551nq",
      "repo": "Overdesk-CALENDAR-LIVE"
    }
  ],
  "files": [
    "dist/**/*",
    "electron-main.cjs",
    "assets/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Overdesk FX Calendar",
    "runAfterFinish": true
  }
}
